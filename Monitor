---
- name: Collect system health from all hosts
  hosts: all
  gather_facts: false
  tasks:
    - name: Get disk usage
      ansible.builtin.command: df -Th
      register: disk_usage
      changed_when: false

    - name: Get memory usage
      ansible.builtin.command: free -h
      register: mem_usage
      changed_when: false

    - name: Get top processes
      ansible.builtin.shell: top -bn1 | head -20
      register: top_output
      changed_when: false

- name: Send consolidated report
  hosts: localhost
  gather_facts: false
  vars:
    smtp_host: "192.168.1.10"
    mail_from: "awx-alerts@hdfc.local"
    mail_to: "your-internal-address@hdfc.local"
  tasks:
    - name: Build and send report
      community.general.mail:
        host: "{{ smtp_host }}"
        port: 25
        from: "{{ mail_from }}"
        to: "{{ mail_to }}"
        subject: "Consolidated System Health Report"
        body: |
          {% for host in groups['all'] %}
          === {{ host }} ===
          -- Disk (df -Th) --
          {{ hostvars[host].disk_usage.stdout }}

          -- Memory (free -h) --
          {{ hostvars[host].mem_usage.stdout }}

          -- Top --
          {{ hostvars[host].top_output.stdout }}

          {% endfor %}
